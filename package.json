		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/jest": "^30.0.0",
		"jest": "^30.4.2",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"ts-jest": "^29.4.11",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
