	"license": "MIT",
	"homepage": "https://github.com/Earney-IT/n8n-nodes-datto-rmm-ext",
	"keywords": [
		"n8n-community-node-package",
		"datto",
		"datto-rmm",
		"kaseya",
		"rmm",
		"msp",
		"endpoint-management",
		"site-variables"
	],
	"author": {
		"name": "Tristen Rice",
		"email": "support@earneyit.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Earney-IT/n8n-nodes-datto-rmm-ext.git"
	},
	"bugs": {
		"url": "https://github.com/Earney-IT/n8n-nodes-datto-rmm-ext/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node build && npm test && n8n-node lint"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"n8n": {
